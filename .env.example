# ─── ContentForge unified environment ────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# LLM (pipeline default: DeepSeek via OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=...            # optional: browser-use demo / BYOK tests

# Tracing (Arize OTEL)
ARIZE_API_KEY=...
ARIZE_SPACE_ID=...

# Platform research (read-only tiers)
X_BEARER_TOKEN=...            # X API v2, free tier: 10k posts/month

# Media (optional)
PIXABAY_API_KEY=...

# Infra (P2+ — SaaS backend)
MONGO_URI=...
HETZNER_OBJ_ENDPOINT=...
HETZNER_OBJ_ACCESS_KEY=...
HETZNER_OBJ_SECRET_KEY=...

# Dev agent / board automation
GITHUB_TOKEN=...
